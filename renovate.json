{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>neteye-platform/repo-commons", ":semanticCommits", ":dependencyDashboard", "schedule:weekly"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Own images are versioned by release-please via Chart.yaml appVersion",
      "matchPackageNames": ["ghcr.io/sthirs/careto/**"],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "security updates",
    "schedule": ["at any time"]
  }
}
